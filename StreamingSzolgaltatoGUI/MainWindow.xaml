<Window x:Class="StreamingSzolgaltatoGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StreamingSzolgaltatoGUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="STREAMING"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#E50914"
                   Margin="0,0,0,20"/>

        <TextBox x:Name="SearchBox"
                 Grid.Row="1"
                 Height="35"
                 FontSize="16"
                 Padding="8"
                 Margin="0,0,0,15"
                 TextChanged="SearchBox_TextChanged"/>

        <ListBox x:Name="ContentList"
                 Grid.Row="2"
                 FontSize="16"
                 Background="#222222"
                 Foreground="White"
                 BorderThickness="0"
                 Padding="8"
                 SelectionChanged="ContentList_SelectionChanged"/>

        <StackPanel Grid.Row="3"
                    Margin="0,20,0,0">
            <Button Content="Leghosszabb tartalom"
                    Height="40"
                    Width="220"
                    HorizontalAlignment="Left"
                    Background="#E50914"
                    Foreground="White"
                    FontSize="15"
                    Click="LongestButton_Click"/>

            <TextBlock x:Name="InfoText"
                       Foreground="White"
                       FontSize="16"
                       Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</Window>
